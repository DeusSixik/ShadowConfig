{
  "schemaVersion": 1,
  "id": "shadowconfig",
  "version": "${version}",
  "name": "Shadow Config",
  "description": "Extensible configuration library for mods, designed to simplify config management with many functions and multiple file extensions",
  "authors": [
    "ShadowKing21"
  ],
  "contact": {
    "homepage": ""
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/shadowconfig/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.shadowking21.shadowconfig.fabric.ShadowConfigFabric"
    ],
    "client": [
      "net.shadowking21.shadowconfig.fabric.client.ShadowConfigFabricClient"
    ]
  },
  "mixins": [
    "shadowconfig.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.3",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
